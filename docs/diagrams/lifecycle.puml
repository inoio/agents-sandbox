@startuml
skinparam defaultTextAlignment center
' opencode-sandbox — invocation lifecycle (from internal/sandbox/vm/run_orchestrate.go)
title opencode-sandbox — lifecycle

start
:Auto-prune\nremove stale VMs, volumes, images (once per process);
:Pre-flight checks (doctor)\nDocker, KVM, Git, msb;
:Resolve opencode version\nreuse baked-in version or pin one via --open-code-version;

:Runner image verify\nDockerfile → inspect existing Docker image;
if (image cached & unchanged?) then (no)
    :Build runner image\nresolve latest opencode if unpinned; base + project layers;
endif

if (newer opencode available?\nchecked once per day & per version) then (yes)
    :Prompt: rebuild runner image?\nRebuild / Keep / Quit;
else (no)
endif

:Home volume verify\nread state file, check msb volume;
if (volume exists?) then (no)
    :Create home volume\nprefill from runner image;
endif

:Detect config changes\ncompare image, env, secrets, network, opencode config;
if (config changed?) then (recreate)
    if (other clients attached?) then (yes)
        :Prompt: rebuild VM?\nKeep current VM / Quit;
    else (no)
        :Rebuild VM (no other client attached);
    endif
    if (image changed?) then (yes)
        :Prompt: existing home volume?\nKeep / Migrate / Reset / Quit;
    else (no)
    endif
else (daemon restart)
    if (other clients attached?) then (yes)
        :Prompt: restart server?\nKeep / Restart / Quit;
    else (no)
        :Restart daemon (no other client attached);
    endif
endif

if (VM exists?) then (no)
    :Load runner image into microsandbox;
    :Create VM\nmount /workspace, /home/dev, /tmp; apply env, secrets, network;
else (yes)
    if (VM running?) then (yes)
        :Connect to existing VM;
    else (stopped / crashed)
        :Start existing VM;
    endif
endif

:Provisioning\ncopy opencode config, home.yaml;
if (fresh boot?) then (yes)
    :Run startup hooks;
    :Start dockerd (if present)\nno-op when already running;
else (no)
endif
:Verify / start opencode serve daemon;

if (--worktree?) then (yes)
    :Resolve or create VM-internal worktree;
endif

:Interactive opencode session\nopencode attach; work with the agent in the VM;

:Cleanup / detach\nrelease client lease; hold VM until sessions quiesce;

stop
@enduml