+func TestOpencode2LatestVersionCancelledCtx(t *testing.T) {
+	a, _ := agent.Lookup("opencode2")
+	checker, ok := agent.AsUpgradeChecker(a)
+	if !ok {
+		t.Fatal("opencode2 should implement UpgradeChecker")
