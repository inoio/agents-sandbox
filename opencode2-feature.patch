+func TestOpencode2ProvisionRules(t *testing.T) {
+	a, _ := agent.Lookup("opencode2")
+	provisioner, ok := agent.AsProvisioner(a)
+	if !ok {
+		t.Fatal("opencode2 should implement Provisioner")
